GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Bootstrap officer (seed only) ---
# Used ONCE on first startup to seed the initial officer into the DB.
# After seeding, officers live in the database — not here.
BOOTSTRAP_OFFICER_ID=PO-001
BOOTSTRAP_OFFICER_PASSWORD=change-this-before-demo

MAX_FILE_SIZE_MB=50
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
