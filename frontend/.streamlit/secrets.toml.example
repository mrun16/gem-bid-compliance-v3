# -------------------------------------------------------
# SendaTender – Streamlit Secrets Template
# -------------------------------------------------------
# Copy this file to .streamlit/secrets.toml for local dev,
# OR paste each key as a Secret in Streamlit Cloud:
#   App settings → Secrets → paste TOML block.
#
# ⚠️  Never commit secrets.toml to git.
# -------------------------------------------------------

# URL of the deployed FastAPI backend
# For Streamlit Cloud this must be a public HTTPS URL, e.g.:
#   BACKEND_URL = "https://your-backend.railway.app"
# For local development leave empty or omit; defaults to http://127.0.0.1:8000
BACKEND_URL = "https://your-backend-url-here.example.com"
